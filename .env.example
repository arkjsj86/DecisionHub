# Copy this file to .env only when you want to override defaults.
# Default mode uses local Codex CLI + Claude CLI, so API keys are optional.

CODEX_PROVIDER=cli
CLAUDE_PROVIDER=cli

CODEX_MODEL=gpt-5.4
# Leave empty to use Claude CLI's default model, or set sonnet/opus/etc.
CLAUDE_MODEL=

# Optional CLI path overrides.
# CODEX_CLI_PATH=C:\Users\Home\.codex\.sandbox-bin\codex.exe
# CLAUDE_CLI_PATH=claude

# Optional API mode. Switch provider(s) to api, then fill keys.
# CODEX_PROVIDER=api
# CLAUDE_PROVIDER=api
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_MODEL=gpt-5.5
# ANTHROPIC_MODEL=claude-opus-4-7

# Optional
PORT=8787
PROJECT_ROOT=..
MAX_CONTEXT_FILES=10
MAX_CONTEXT_CHARS=55000
MAX_OUTPUT_TOKENS=2200
CLI_TIMEOUT_MS=600000
AUTO_SHUTDOWN_ON_IDLE=true
AUTO_SHUTDOWN_GRACE_MS=5000
CLIENT_HEARTBEAT_TTL_MS=15000
